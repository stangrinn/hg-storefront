# Multi-stage build for production
FROM node:20 AS builder

WORKDIR /usr/src/app

# Set build argument for API URL
ARG API_URL
ENV API_URL=${API_URL}

# Copy package files
COPY package.json yarn.lock ./

# Clean install dependencies with yarn
RUN rm -rf node_modules && \
    yarn cache clean && \
    yarn install --frozen-lockfile --network-timeout 600000

# Copy source code
COPY . .

# Build the Angular application with SSR using docker configuration
RUN yarn build:ssr:docker

# Production stage
FROM node:20

WORKDIR /usr/src/app

# Install dumb-init for proper signal handling
RUN apt-get update && apt-get install -y dumb-init && rm -rf /var/lib/apt/lists/*

# Install PM2 globally
RUN npm install -g pm2

# Copy built application
COPY --from=builder /usr/src/app/dist ./dist

# Copy server files
COPY --from=builder /usr/src/app/server.ts ./
COPY --from=builder /usr/src/app/package.json ./
COPY --from=builder /usr/src/app/yarn.lock ./
COPY --from=builder /usr/src/app/process.json ./

# Install only production dependencies with yarn
RUN yarn install --production --frozen-lockfile

# Set non-root user
RUN groupadd -g 1001 nodejs && \
    useradd -u 1001 -g nodejs nodejs && \
    mkdir -p /home/nodejs/.pm2 && \
    chown -R nodejs:nodejs /usr/src/app /home/nodejs

USER nodejs

EXPOSE 4000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
  CMD node -e "require('http').get('http://localhost:4000', (r) => {process.exit(r.statusCode === 200 ? 0 : 1)})"

# Use dumb-init to handle signals properly
ENTRYPOINT ["dumb-init", "--"]

CMD ["pm2-runtime", "process.json"]
