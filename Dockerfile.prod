# Multi-stage build for production
FROM node:20-alpine AS builder

WORKDIR /usr/src/app

# Set build argument for API URL
ARG API_URL
ENV API_URL=${API_URL}

# Copy package files
COPY package.json ./

# Install dependencies fresh (ignore lock files to avoid version conflicts)
RUN npm install --legacy-peer-deps

# Copy source code
COPY . .

# Build the Angular application with SSR
RUN npm run build:ssr

# Production stage
FROM node:20-alpine

WORKDIR /usr/src/app

# Install dumb-init for proper signal handling
RUN apk add --no-cache dumb-init

# Install PM2 globally
RUN npm install -g pm2

# Copy built application
COPY --from=builder /usr/src/app/dist ./dist

# Copy server files
COPY --from=builder /usr/src/app/server.ts ./
COPY --from=builder /usr/src/app/package.json ./
COPY --from=builder /usr/src/app/process.json ./

# Install only production dependencies
RUN npm install --only=production

# Set non-root user
RUN addgroup -g 1001 -S nodejs && \
    adduser -S nodejs -u 1001 && \
    chown -R nodejs:nodejs /usr/src/app

USER nodejs

EXPOSE 4000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
  CMD node -e "require('http').get('http://localhost:4000', (r) => {process.exit(r.statusCode === 200 ? 0 : 1)})"

# Use dumb-init to handle signals properly
ENTRYPOINT ["dumb-init", "--"]

CMD ["pm2-runtime", "process.json"]
